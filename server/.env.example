# ---- Core ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SESSION_SECRET=change-this-to-a-long-random-string

# ---- PostgreSQL (Render provides this automatically as an env var when you
# attach a Postgres instance to the web service; DATABASE_URL is all you need) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskora

# ---- Groq (AI search + action engine) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Mapbox (geocoding + location intelligence) ----
MAPBOX_TOKEN=

# ---- Stripe (payments, Connect payouts, subscriptions) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BOOST_PRICE_ID=

# ---- File uploads ----
# Local disk storage under /uploads (see README "Image storage" section).
# On Render, attach a Persistent Disk mounted at this path so uploads survive deploys.
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads
