# ---- Core ----
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# ---- PostgreSQL (Render provides this automatically as an env var when you
# attach a Postgres instance to the web service; DATABASE_URL is all you need) ----
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taskora

# ---- Supabase (Auth + Storage) ----
# Project URL and Service Role key, from Supabase dashboard > Project Settings
# > API. The service role key is a full-admin secret -- server-side only,
# never send it to the client or commit it. Used to (1) verify the access
# token on every authenticated request, (2) push profile/provider/portfolio
# images to Supabase Storage, and (3) the one-time admin migration endpoint
# that links legacy accounts to their new Supabase identity.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket images are uploaded to (created once in the Supabase
# dashboard as a public bucket). Defaults to 'taskora-uploads' if unset.
SUPABASE_STORAGE_BUCKET=taskora-uploads

# ---- Groq (AI search + action engine) ----
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---- Mapbox (geocoding + location intelligence) ----
MAPBOX_TOKEN=

# ---- Stripe (payments, Connect payouts, subscriptions) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BOOST_PRICE_ID=

# ---- File uploads (invoices only) ----
# Profile/provider/portfolio images moved to Supabase Storage (see above).
# Invoice PDFs (services/invoice.service.js) still use local disk -- this
# wasn't part of that migration and sits inline with the Stripe payment
# flow. On Render, attach a Persistent Disk mounted at this path so invoices
# survive deploys (otherwise unchanged, pre-existing limitation).
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=http://localhost:4000/uploads

# ---- Black Daddy Tech connector ----
# No setup needed here. In the live app, go to Admin -> IT -> "Generate
# connection key", paste that one key into BDT Admin -> Websites -> Add a
# website -> Connect with API key, and press Connect. See
# src/routes/it.routes.js and src/lib/bdt-connector.js.
# (BDT_URL / BDT_SITE_ID / BDT_SITE_SECRET below are an optional manual
# override and are not needed for the normal flow above.)
BDT_URL=
BDT_SITE_ID=
BDT_SITE_SECRET=
